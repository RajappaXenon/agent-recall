{
  "name": "@agent-recall/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "start": "node dist/server.js",
    "worker": "tsx src/worker.ts",
    "worker:prod": "node dist/worker.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "setup:indexes": "tsx src/scripts/setup-indexes.ts",
    "seed": "tsx src/scripts/seed.ts",
    "embed:backfill": "tsx src/scripts/embed-backfill.ts",
    "demo:reset": "tsx src/scripts/demo-reset.ts",
    "demo:e2e": "tsx src/scripts/demo-e2e.ts",
    "worker:supervised": "tsx src/scripts/worker-supervised.ts"
  },
  "dependencies": {
    "@agent-recall/shared": "0.1.0",
    "@anthropic-ai/sdk": "^0.133.0",
    "@fastify/cors": "^11.0.0",
    "@fastify/jwt": "^9.0.0",
    "@fastify/rate-limit": "^10.2.0",
    "@fastify/swagger": "^9.4.0",
    "@fastify/swagger-ui": "^5.2.0",
    "dotenv": "^16.4.0",
    "fastify": "^5.2.0",
    "fastify-plugin": "^5.1.0",
    "fastify-type-provider-zod": "^4.0.2",
    "mongodb": "^6.12.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
