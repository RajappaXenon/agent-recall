# --- Required ---
NODE_ENV=development
PORT=4000
# Your MongoDB Atlas connection string (never commit the real value)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DB_NAME=agent_recall
# Optional: DNS servers for mongodb+srv lookups if Node cannot resolve SRV records (querySrv ECONNREFUSED)
DNS_SERVERS=
FRONTEND_URL=http://localhost:5173
JWT_SECRET=change-me-to-a-long-random-string
AUTH_MODE=demo

# --- Semantic search (Voyage AI) ---
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3.5
VOYAGE_DIMENSIONS=1024
# https://api.voyageai.com/v1 (key from voyageai.com) or https://ai.mongodb.com/v1 (Atlas model API key)
VOYAGE_BASE_URL=https://api.voyageai.com/v1

# --- LLM answers (otherwise template answers) ---
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=claude-opus-5-5

# --- Optional ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
DEMO_MODE=true
LEASE_MS=15000
DEMO_STEP_DELAY_MS=4000
LOG_LEVEL=info
