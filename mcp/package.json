    "smoke": "tsx src/smoke.ts"
  },
  "dependencies": {
    "@agent-recall/shared": "0.1.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
